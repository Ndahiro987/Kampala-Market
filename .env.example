# Copy to .env for local Docker Compose. These credentials are for local testing only.
POSTGRES_DB=kampala_market
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_KEY=local-only-kampala-market-secret-key-change-before-deploy

# Copy this setting to src/web/.env.local to run the Next.js client.
NEXT_PUBLIC_API_URL=http://localhost:5074
